---
import type { ServiceSnapshot } from '../lib/history';

/** Trusted average per run as an inline SVG (no JS), with the rule's threshold as a dashed line. */
interface Props { snapshots: ServiceSnapshot[]; threshold: number; label: string }
const { snapshots, threshold, label } = Astro.props;
const W = 160;
const H = 40;
const values = snapshots.filter((s) => s.count > 0).map((s) => Number(s.average) / 10 ** s.decimals);
const y = (v: number) => H - 2 - (Math.max(0, Math.min(100, v)) / 100) * (H - 4);
const points = values.map((v, i) => `${values.length === 1 ? W / 2 : (i / (values.length - 1)) * W},${y(v).toFixed(1)}`).join(' ');
const summary = label.replace('{values}', values.length ? values.map((v) => Math.round(v)).join(' → ') : '–');
---

<svg class="spark" viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={summary}>
  <line x1="0" x2={W} y1={y(threshold)} y2={y(threshold)} class="threshold" />
  {values.length > 1 && <polyline points={points} class="line" />}
  {values.length > 0 && <circle cx={points.split(' ').at(-1)!.split(',')[0]} cy={points.split(' ').at(-1)!.split(',')[1]} r="2.5" class="dot" />}
</svg>

<style>
  .spark { display: block; overflow: visible; }
  .threshold { stroke: var(--text-muted); stroke-dasharray: 3 3; stroke-width: 1; opacity: 0.6; }
  .line { fill: none; stroke: var(--accent); stroke-width: 1.75; stroke-linejoin: round; }
  .dot { fill: var(--accent); }
</style>
