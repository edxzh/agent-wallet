---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
const repo = 'https://github.com/edxzh/agent-wallet';
const spec = `${repo}/blob/main/specs/001-agent-wallet-demo/spec.md`;
// Sample budgets for the preview only (matches the preview rows: one 0.01 payment settled).
const sample = { dailySpent: 0.01, daily: 5, taskSpent: 0.01, task: 2 };
const pct = (a: number, b: number) => `${Math.max(2, (a / b) * 100)}%`;
---

<section class="hero">
  <p class="eyebrow">{d.eyebrow}</p>
  <h1>{d.heading}</h1>
  <p class="intro">{d.intro}</p>
  <p class="status card">
    <span class="dot" aria-hidden="true"></span>
    <strong>{d.statusLabel}:</strong>
    {d.status}
  </p>
  <div class="ctas">
    <a class="btn btn-primary" href={repo}>{d.repoCta}</a>
    <a class="btn btn-secondary" href={spec}>{d.specCta}</a>
  </div>
</section>

<section class="section" aria-labelledby="how">
  <h2 id="how">{d.how.heading}</h2>
  <ol class="steps" role="list">
    {
      d.how.steps.map((s, i) => (
        <li class="card">
          <span class="num mono">{i + 1}</span>
          <h3>{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<section class="section" aria-labelledby="rules">
  <h2 id="rules">{d.rules.heading}</h2>
  <p class="lead muted">{d.rules.intro}</p>
  <ul class="grid" role="list">
    {
      d.rules.items.map((r) => (
        <li class="card">
          <h3>{r.name}</h3>
          <p class="muted">{r.body}</p>
          <p class="example mono">{r.example}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="section" aria-labelledby="reasons">
  <h2 id="reasons">{d.reasons.heading}</h2>
  <p class="lead muted">{d.reasons.intro}</p>
  <ol class="reasons card" role="list">
    {
      d.reasons.items.map((r) => (
        <li>
          <code>{r.code}</code>
          <span>{r.body}</span>
        </li>
      ))
    }
  </ol>
</section>

<section class="section" aria-labelledby="preview">
  <h2 id="preview">{d.preview.heading}</h2>
  <p class="sample mono" role="note">{d.preview.note}</p>
  <div class="card preview">
    <p class="agent mono">{d.preview.agent}</p>
    <div class="meters">
      <div>
        <p class="meter-label">
          <span>{d.preview.dailyLabel}</span>
          <span class="mono">{sample.dailySpent.toFixed(2)} / {sample.daily.toFixed(2)} USDC</span>
        </p>
        <div class="meter"><span style={`width:${pct(sample.dailySpent, sample.daily)}`}></span></div>
      </div>
      <div>
        <p class="meter-label">
          <span>{d.preview.taskLabel}</span>
          <span class="mono">{sample.taskSpent.toFixed(2)} / {sample.task.toFixed(2)} USDC</span>
        </p>
        <div class="meter"><span style={`width:${pct(sample.taskSpent, sample.task)}`}></span></div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">{d.preview.colTime}</th>
            <th scope="col">{d.preview.colWhat}</th>
            <th scope="col">{d.preview.colAmount}</th>
            <th scope="col">{d.preview.colResult}</th>
          </tr>
        </thead>
        <tbody>
          {
            d.preview.rows.map((r, i) => (
              <tr>
                <td class="mono">{r.time}</td>
                <td class="mono">{r.what}</td>
                <td class="mono">{r.amount}</td>
                <td class:list={['mono', i === 0 ? 'ok' : 'bad']}>{r.result}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="stack">
  <h2 id="stack">{d.stack.heading}</h2>
  <ul class="chips" role="list">{d.stack.items.map((s) => <li class="mono">{s}</li>)}</ul>
</section>

<footer class="foot muted">
  <p>{d.footer}</p>
  <p><a href={repo}>github.com/edxzh/agent-wallet</a></p>
</footer>

<style>
  .hero {
    padding-bottom: calc(var(--section-gap) / 2);
  }
  .hero .eyebrow {
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(34px, 5.5vw, var(--fs-hero));
    line-height: var(--lh-hero);
    max-width: 20ch;
  }
  .intro {
    max-width: 62ch;
    margin-top: 20px;
    color: var(--text-muted);
  }
  .status {
    margin-top: 32px;
    max-width: 62ch;
    padding: 18px 22px;
    font-size: 15px;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 10px #f59e0b;
    vertical-align: middle;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  h2 {
    margin-bottom: 12px;
  }
  .lead {
    max-width: 62ch;
    margin-bottom: 28px;
  }
  .steps,
  .grid {
    display: grid;
    gap: 16px;
    padding: 0;
    margin-top: 28px;
  }
  .steps {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .grid {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin-top: 0;
  }
  .steps h3,
  .grid h3 {
    margin-bottom: 8px;
    font-size: 18px;
  }
  .steps p,
  .grid p {
    font-size: 15px;
    line-height: 1.6;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: rgb(34 211 238 / 0.15);
    color: var(--accent);
    font-size: 14px;
  }
  .example {
    margin-top: 12px;
    color: var(--accent);
    font-size: 13px !important;
  }
  .reasons {
    display: grid;
    gap: 0;
    padding: 8px 28px;
  }
  .reasons li {
    display: grid;
    grid-template-columns: minmax(200px, 240px) 1fr;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .reasons li:last-child {
    border-bottom: 0;
  }
  code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #fca5a5;
    overflow-wrap: anywhere;
  }
  .sample {
    display: inline-block;
    margin-bottom: 20px;
    padding: 4px 12px;
    border: 1px dashed var(--text-muted);
    border-radius: 999px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .agent {
    font-size: 15px;
    color: var(--text);
    margin-bottom: 18px;
  }
  .meters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }
  .meter-label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .meter {
    height: 8px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .meter span {
    display: block;
    height: 100%;
    background: var(--gradient);
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  th,
  td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  th {
    color: var(--text-muted);
    font-weight: 500;
  }
  .ok {
    color: #34d399;
  }
  .bad {
    color: #fca5a5;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    margin-top: 20px;
  }
  .chips li {
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 13px;
    background: var(--surface);
  }
  .foot {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .reasons {
      padding: 4px 20px;
    }
    .reasons li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
