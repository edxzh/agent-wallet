---
import { t, type Lang } from '../i18n';
import RulesCard from './RulesCard.astro';
import SpendBars from './SpendBars.astro';
import Timeline from './Timeline.astro';
import { history, labelsFor, rowTextFor } from '../lib/history';
import { formatTime } from '../lib/rows';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const repo = 'https://github.com/edxzh/agent-wallet';
const spec = `${repo}/blob/main/specs/001-agent-wallet-demo/spec.md`;
const wallet = history?.wallets[0];
const updated = history ? formatTime(history.generatedAt, lang) : '';
// Data for the live tail (src/scripts/live-tail.ts): small, no event history beyond pending rows.
const liveData = wallet && history && {
  lang,
  lastBlock: history.lastBlock,
  generatedAt: history.generatedAt,
  updated,
  wallet: wallet.address,
  dailyBudget: wallet.policy.dailyBudget,
  pending: wallet.events.filter((e) => e.kind === 'authorized' && !e.settled),
  labels: labelsFor(wallet, lang),
  text: rowTextFor(lang),
  networkDown: d.live.networkDown,
};
---

<section class="hero">
  <p class="eyebrow">{d.eyebrow}</p>
  <h1>{d.heading}</h1>
  <p class="intro">{d.intro}</p>
  <p class="status card">
    <span class:list={['dot', wallet && 'live']} aria-hidden="true"></span>
    <strong>{d.statusLabel}:</strong>{' '}{wallet ? d.statusLive.replace('{time}', updated) : d.statusEmpty}
  </p>
  <div class="ctas">
    <a class="btn btn-primary" href={repo}>{d.repoCta}</a>
    <a class="btn btn-secondary" href={spec}>{d.specCta}</a>
  </div>
</section>

{wallet && (
  <section class="section live" aria-labelledby="live">
    <h2 id="live">{d.live.heading}</h2>
    <p class="lead muted">
      {d.live.intro}{' '}
      <span class="mono">{d.live.wallet} {wallet.name}</span>{' '}
      <a href={`https://sepolia.basescan.org/address/${wallet.address}`} rel="noopener" target="_blank">{d.live.contract}</a>
    </p>
    <div class="live-grid">
      <div class="col">
        <RulesCard lang={lang} wallet={wallet} />
        <SpendBars lang={lang} wallet={wallet} />
      </div>
      <Timeline lang={lang} wallet={wallet} />
    </div>
    <script type="application/json" id="aw-live" set:html={JSON.stringify(liveData)} />
  </section>
)}

<section class="section" aria-labelledby="how">
  <h2 id="how">{d.how.heading}</h2>
  <ol class="steps" role="list">
    {
      d.how.steps.map((s, i) => (
        <li class="card">
          <span class="num mono">{i + 1}</span>
          <h3>{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<section class="section" aria-labelledby="rules">
  <h2 id="rules">{d.rules.heading}</h2>
  <p class="lead muted">{d.rules.intro}</p>
  <ul class="grid" role="list">
    {
      d.rules.items.map((r) => (
        <li class="card">
          <h3>{r.name}</h3>
          <p class="muted">{r.body}</p>
          <p class="example mono">{r.example}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="section" aria-labelledby="reasons">
  <h2 id="reasons">{d.reasons.heading}</h2>
  <p class="lead muted">{d.reasons.intro}</p>
  <ol class="reasons card" role="list">
    {
      d.reasons.items.map((r) => (
        <li>
          <code>{r.code}</code>
          <span>{r.body}</span>
        </li>
      ))
    }
  </ol>
</section>

<section class="section" aria-labelledby="stack">
  <h2 id="stack">{d.stack.heading}</h2>
  <ul class="chips" role="list">{d.stack.items.map((s) => <li class="mono">{s}</li>)}</ul>
</section>

<script>
  // Load the live tail after first paint and idle time, so it never costs first-screen JS.
  const load = () => import('../scripts/live-tail').then((m) => m.start());
  // With a timeout: background tabs may never report idle time.
  const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 2000 }) : setTimeout(cb, 1));
  if (document.getElementById('aw-live')) {
    if (document.readyState === 'complete') idle(load);
    else addEventListener('load', () => idle(load));
  }
</script>

<footer class="foot muted">
  <p>{d.footer}</p>
  <p><a href={repo}>github.com/edxzh/agent-wallet</a></p>
</footer>

<style>
  .hero {
    padding-bottom: calc(var(--section-gap) / 2);
  }
  .hero .eyebrow {
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(34px, 5.5vw, var(--fs-hero));
    line-height: var(--lh-hero);
    max-width: 20ch;
  }
  .intro {
    max-width: 62ch;
    margin-top: 20px;
    color: var(--text-muted);
  }
  .status {
    margin-top: 32px;
    max-width: 62ch;
    padding: 18px 22px;
    font-size: 15px;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 10px #f59e0b;
    vertical-align: middle;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  h2 {
    margin-bottom: 12px;
  }
  .lead {
    max-width: 62ch;
    margin-bottom: 28px;
  }
  .steps,
  .grid {
    display: grid;
    gap: 16px;
    padding: 0;
    margin-top: 28px;
  }
  .steps {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .grid {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin-top: 0;
  }
  .steps h3,
  .grid h3 {
    margin-bottom: 8px;
    font-size: 18px;
  }
  .steps p,
  .grid p {
    font-size: 15px;
    line-height: 1.6;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: rgb(34 211 238 / 0.15);
    color: var(--accent);
    font-size: 14px;
  }
  .example {
    margin-top: 12px;
    color: var(--accent);
    font-size: 13px !important;
  }
  .reasons {
    display: grid;
    gap: 0;
    padding: 8px 28px;
  }
  .reasons li {
    display: grid;
    grid-template-columns: minmax(200px, 240px) 1fr;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .reasons li:last-child {
    border-bottom: 0;
  }
  code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #fca5a5;
    overflow-wrap: anywhere;
  }
  .dot.live {
    background: #34d399;
    box-shadow: 0 0 10px #34d399;
  }
  .live-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px;
    align-items: start;
  }
  .live-grid .col {
    display: grid;
    gap: 16px;
  }
  @media (max-width: 900px) {
    .live-grid {
      grid-template-columns: 1fr;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    margin-top: 20px;
  }
  .chips li {
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 13px;
    background: var(--surface);
  }
  .foot {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .reasons {
      padding: 4px 20px;
    }
    .reasons li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
