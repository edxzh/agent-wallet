---
import { t, type Lang } from '../i18n';
import { formatTime, identityLink, shortAddress } from '../lib/rows';
import type { ServiceView } from '../lib/history';
import Sparkline from './Sparkline.astro';

interface Props { lang: Lang; service: ServiceView; threshold: number; allowlisted: boolean }
const { lang, service: s, threshold, allowlisted } = Astro.props;
const d = t(lang);
const tr = d.trust;
const reasons = d.reason as Record<string, string>;
const avg = s.summary && s.summary.count > 0 ? (Number(s.summary.average) / 10 ** s.summary.decimals).toFixed(s.summary.decimals ? 1 : 0) : undefined;
const mismatch = s.registeredWallet && s.payTo && s.registeredWallet.toLowerCase() !== s.payTo.toLowerCase();
const reasonText = s.payable ? (allowlisted ? tr.allowlisted : '') : s.reason === 'NOT_CONFIGURED' ? tr.notConfigured : (reasons[s.reason ?? ''] ?? s.reason);
---

<li class="card service" data-service={s.key} data-agent-id={s.agentId ?? ''}>
  <div class="top">
    <h4>{s.label[lang]}</h4>
    <span class:list={['badge', s.payable ? 'on' : 'off']} data-svc="badge">{s.payable ? tr.payable : tr.notPayable}</span>
  </div>
  <p class="reason" data-svc="reason">{reasonText}</p>
  {s.since && <p class="since mono">{tr.since.replace('{time}', formatTime(s.since, lang))}</p>}

  {s.summary ? (
    <div class="score">
      <div>
        <p class="num" data-svc="average">{avg ?? '–'}</p>
        <p class="lbl">{tr.average}</p>
      </div>
      <div>
        <p class="num" data-svc="count">{s.summary.count}</p>
        <p class="lbl">{tr.count}</p>
      </div>
      <Sparkline snapshots={s.snapshots} threshold={threshold} label={tr.trend} />
    </div>
  ) : (
    <p class="muted">{tr.noIdentity}</p>
  )}
  {s.summary && s.summary.count === 0 && <p class="muted">{tr.noReviews}</p>}
  {s.summary && s.summary.count > 1500 && <p class="warn">{tr.nearLimit.replace('{count}', String(s.summary.count))}</p>}

  <dl>
    {s.agentId !== null && (
      <div>
        <dt>{tr.claims.replace('{id}', s.agentId)}</dt>
        <dd><a href={identityLink(s.agentId)} rel="noopener" target="_blank">{tr.identityLink}</a></dd>
      </div>
    )}
    {s.payTo && <div><dt>{tr.paidAt}</dt><dd class="mono">{shortAddress(s.payTo)}</dd></div>}
    {s.registeredWallet && (
      <div>
        <dt>{tr.registeredTo}</dt>
        <dd class="mono">{shortAddress(s.registeredWallet)} {mismatch && <span class="warn">({tr.mismatch})</span>}</dd>
      </div>
    )}
  </dl>
</li>

<style>
  .service { display: grid; gap: 8px; align-content: start; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  h4 { font-size: 16px; }
  .badge { font: 12px var(--font-mono); padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
  .badge.on { color: #34d399; background: rgb(52 211 153 / 0.12); }
  .badge.off { color: #fca5a5; background: rgb(252 165 165 / 0.12); }
  .reason { font-size: 14px; color: var(--text-muted); min-height: 1.4em; }
  .since { font-size: 12px; color: var(--text-muted); }
  .score { display: flex; align-items: end; gap: 20px; margin: 4px 0; flex-wrap: wrap; }
  .num { font: 600 24px var(--font-mono); line-height: 1; }
  .lbl { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
  dl { display: grid; gap: 4px; margin: 4px 0 0; font-size: 13px; }
  dl > div { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: baseline; }
  dt { color: var(--text-muted); min-width: 0; }
  dd { margin: 0; text-align: right; white-space: nowrap; }
  dd .warn { display: block; }
  .muted { color: var(--text-muted); font-size: 13px; }
  .warn { color: #fbbf24; font-size: 13px; }
</style>
