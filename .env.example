# Agent Wallet: local configuration. Copy to .env (git-ignored) and fill in.
# TEST NETWORK ONLY (Base Sepolia, chain id 84532). Every script refuses other networks.

RPC_URL=https://sepolia.base.org

# Operator: owns the wallets and changes rules.
# NEVER put this key in CI, GitHub secrets, logs, commits or chat (constitution IV).
OPERATOR_PRIVATE_KEY=

# Agent: can only request payments within its rules. May also be added as a GitHub secret.
AGENT_PRIVATE_KEY=

# Address that receives payments for the demo API (no private key needed here).
SERVICE_PAYEE=

# Filled in after deployment
FACTORY_ADDRESS=
WALLET_ADDRESS=
