{
  "name": "agent-wallet-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:contracts": "cd contracts && forge build && cd .. && tsx scripts/export-abi.ts",
    "test:contracts": "cd contracts && forge test -vv",
    "test": "npm run test -ws --if-present && npm run test:scripts",
    "typecheck": "npm run typecheck -ws --if-present",
    "snapshot": "tsx scripts/snapshot.ts",
    "scenario": "npm run cli -w packages/agent -- run-scenario",
    "test:scripts": "vitest run scripts"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "tsx": "^4.23.15"
  }
}
